    },
    "privacy.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fragments stay on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段只留在这台 Mac 上。"
          }
        }
      }
    },
    "appearance.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet surfaces. Clear fragments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让片段清晰，让光影安静。"
          }
        }
      }
    },
    "permissions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each permission has a separate purpose."
          }
        },
        "zh-Hans": {
