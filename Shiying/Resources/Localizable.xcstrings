          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "poll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Interval"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集间隔"
          }
        }
      }
    },
    "general.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control+V opens the compact panel at the bottom right of the current screen. The menu bar icon is hidden by default. Copy a fragment, then press Command+V in the destination app. Capture observes the latest clipboard state; very rapid copies may be missed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Control+V 在当前屏幕右下角唤出紧凑面板，菜单栏图标默认隐藏。复制片段后，在目标应用按 Command+V 粘贴。采集观察剪贴板的最新状态，快速连续复制可能遗漏。"
          }
        }
      }
    },
    "retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep up to 30 items, including favorites. When all 30 are saved, keep 5 additional recent items. History survives restarts and doesn’t expire by age."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规保留 30 条，包含收藏；全部收藏后，额外保留最近 5 条。重启后仍可使用，不按天数过期。"
          }
        }
      }
    },
    "capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted Payload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密载荷"
          }
        }
      }
    },
    "databaseSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Database File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库文件"
          }
        }
      }
    },
    "limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text and rich text: 1 MiB combined. All formats and items: 32 MiB per capture. Images: 40 MP. Shared encrypted payload budget: 200 MiB. Database free pages and transaction space are additional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本与富文本合计上限 1 MiB；单次所有项目和格式合计 32 MiB；图片上限 4,000 万像素。共享加密载荷预算 200 MiB，数据库空闲页与事务空间另计。"
          }
        }
      }
    },
    "clearUnsaved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Unsaved History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空非收藏历史"
          }
        }
      }
    },
    "clearAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear All History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空全部历史"
          }
        }
      }
    },
    "clearAll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all history?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空全部历史？"
          }
        }
      }
    },
    "clearAll.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All fragments, including favorites, will be deleted. The current system clipboard is unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除全部片段，包含收藏。系统当前剪贴板不受影响。"
          }
        }
      }
    },
    "clearUnsaved.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved history will be deleted. Your favorites and current system clipboard are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除非收藏历史，收藏和当前系统剪贴板将保留。"
          }
        }
      }
    },
    "delete.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting history does not clear the current clipboard. Deletion cannot remove system backups, APFS snapshots, or copies held by other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除历史不会清空当前剪贴板，也无法删除系统备份、APFS 快照或其他应用持有的副本。"
          }
        }
      }
    },
    "clearClipboard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Current Clipboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空当前剪贴板"
          }
        }
      }
    },
    "clearClipboard.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the current system clipboard will be cleared. Saved history is unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清空系统当前剪贴板，不删除已保存的历史。"
          }
        }
      }
    },
    "privacy.capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts only after you enable it. Quit Shiying to stop recording; existing history remains encrypted on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你开启后持续记录剪贴板。退出拾影即可停止记录，已有历史仍加密保存在本机。"
          }
        }
      }
    },
    "excludedApps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded Applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除应用"
          }
        }
      }
    },
