    "exclusion.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The observed frontmost app is only a possible source. Exclusions cannot reliably identify every clipboard owner or secret."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前台应用只是可能来源，排除规则无法可靠识别所有剪贴板来源或敏感内容。"
          }
        }
      }
    },
    "excluded.edit.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One application bundle ID per line. This list is editable, including suggested password managers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个应用的 Bundle ID。可以编辑建议排除的密码管理器名单。"
          }
        }
      }
    },
    "privacy.encryption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content, file URLs and previews use AES-GCM with a local, non-synchronizing Keychain key. The database still contains IDs, timestamps, types, sizes, favorite flags and keyed fingerprints. No accounts, uploads, analytics, or third-party runtime dependencies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容、文件 URL 与预览使用 AES-GCM 加密，密钥保存在本机非同步钥匙串。数据库仍包含 ID、时间、类型、大小、收藏标志及密钥指纹。无需账号，无上传、遥测和第三方运行时依赖。"
          }
        }
      }
    },
    "privacy.sensitive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concealed and transient clipboard markers are skipped. Unmarked passwords, tokens or identity documents can still be recorded. Locking clears decrypted previews and pauses capture; unlocking starts a new baseline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过 concealed、transient 等敏感标记。未标记的密码、令牌或证件内容仍可能被记录。锁屏时清除解密预览并暂停采集，解锁后建立新基线。"
          }
        }
      }
    },
