        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup, wake and unlock never open password dialogs automatically. If access is needed, click Authorize Keychain and choose Always Allow in the system prompt to remember this signed app. No key is replaced and history is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动、唤醒和解锁不会自动弹出密码窗口。如需授权，请点击“授权钥匙串”，在系统提示中选择“始终允许”以记住此签名版本。不会替换密钥或清空历史。"
          }
