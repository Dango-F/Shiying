    "history.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what matters, with room for the next fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
