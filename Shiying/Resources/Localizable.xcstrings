    "about.story": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“拾” gathers a fragment; “影” is an impression left behind. Copying keeps an impression. Pasting gives it another place to settle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“拾”是收取片段，“影”是原物留下的映像。复制如拾影，粘贴则让影像在另一处落定，轻盈而含蓄。"
          }
        }
      }
    },
    "about.technology": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Swift 6 and AppKit. System SQLite, CryptoKit, Keychain and ImageIO. Single process. No web renderer or bundled fonts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Swift 6 与 AppKit。复用系统 SQLite、CryptoKit、Keychain 和 ImageIO。单进程，无网页渲染器或内嵌字体。"
          }
        }
      }
    },
    "about.website": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development build. A release website and Developer ID notarization have not been configured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版本，尚未配置发布官网、Developer ID 签名与公证。"
          }
        }
      }
    },
