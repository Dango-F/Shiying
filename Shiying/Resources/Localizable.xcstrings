    "permission.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For continuous capture, choose Always Allow for Shiying in Privacy & Security → Paste from Other Apps. Ask and Deny stop background reads to avoid recurring prompts. Existing history stays usable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续记录需在隐私与安全性 → 从其他 App 粘贴中，将拾影设为始终允许。询问或拒绝时停止后台读取，避免反复弹窗；仍可使用已有历史。"
          }
        }
      }
    },
